{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-plus-plus.dev/schemas/proof-context/v0.1/canonicalization.schema.json",
  "title": "PCCE proof-context v0.1 canonicalization",
  "description": "v0.1 canonical bytes are RFC 8785 JCS (mcpp-jcs-v1). A second canonicalizer MUST NOT be copied into a production package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "standard",
    "unicode",
    "reject_nan_infinity"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "pcce/proof-context/v0.1/canonicalization"
    },
    "algorithm": {
      "type": "string",
      "const": "mcpp-jcs-v1"
    },
    "standard": {
      "type": "string",
      "const": "RFC 8785"
    },
    "unicode": {
      "type": "string",
      "const": "NFC"
    },
    "reject_nan_infinity": {
      "type": "boolean",
      "const": true
    }
  }
}
