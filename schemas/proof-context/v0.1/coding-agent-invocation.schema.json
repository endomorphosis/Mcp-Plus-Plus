{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-plus-plus.dev/schemas/proof-context/v0.1/coding-agent-invocation.schema.json",
  "title": "PCCE CodingAgentInvocation@0.1",
  "description": "Provider-neutral invocation contract. Does not grant MCP++ execution authority. MCP++ owns the wire contract only; canonical producer semantics remain with datasets, kit, or accelerator. additionalProperties is false.",
  "$comment": "PCCE-006. Version 0.1 is immutable after admission; incompatible changes require a new version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocation_cid",
    "task_id",
    "repository_state_cid",
    "provider",
    "model",
    "revision",
    "tier",
    "provenance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "pcce/proof-context/v0.1/coding-agent-invocation",
      "description": "Closed v0.1 schema marker. Unknown or other versions are rejected."
    },
    "invocation_cid": {
      "$ref": "#/$defs/cid"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repository_state_cid": {
      "$ref": "#/$defs/cid"
    },
    "route_cid": {
      "$ref": "#/$defs/cid"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "token_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cached_token_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cost_micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "response_artifact_cid": {
      "$ref": "#/$defs/cid"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "cid": {
      "type": "string",
      "description": "CIDv1 base32. Pseudo-CIDs (sha256:, urn: without codec, hex digests, Qm placeholders) are rejected.",
      "pattern": "^b[a-z2-7]{58,}$",
      "minLength": 59,
      "maxLength": 128
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$",
      "description": "Git object id (sha1 or sha256 hex)."
    },
    "iso8601": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "rejected",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "model_escalation_required",
        "human_review_required",
        "unavailable",
        "timeout",
        "cancelled",
        "invalid",
        "stale",
        "simulated",
        "infrastructure_failure",
        "partial_effect",
        "repair_required"
      ]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "unknown_field",
        "malformed",
        "identity_inconsistent",
        "stale_root",
        "simulated_promoted",
        "pseudo_cid",
        "schema_mismatch",
        "boundary_violation",
        "unavailable_capability",
        "timeout",
        "cancelled",
        "verification_failed",
        "proof_failed",
        "assurance_failed",
        "context_insufficient",
        "infrastructure_failure",
        "partial_effect",
        "repair_required",
        "human_review_required"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "live",
        "replayed",
        "simulated"
      ]
    }
  }
}
