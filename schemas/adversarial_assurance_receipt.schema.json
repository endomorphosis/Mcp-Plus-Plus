{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-plus-plus.dev/schemas/adversarial-assurance/receipt.schema.json",
  "title": "MCP++ adversarial-assurance campaign receipt (shared wire) v1",
  "description": "Language-neutral, fail-closed JSON Schema for the shared AssuranceCampaignReceipt@1 wire identity (AAE-013). Mirrors the datasets-owned signed receipt contract without inventing envelopes, cryptography, MCP++ profiles, or runtime code. Unknown fields and unsupported enums fail closed. Signature verification reuses existing EdDSA/did:key authority vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "interface_id",
    "header",
    "receipt_id",
    "campaign_plan_cid",
    "campaign_policy_cid",
    "campaign_policy_version",
    "admitted_set_cid",
    "expected_detection_sets_cid",
    "outcomes_cid",
    "survivor_reports_cid",
    "vacuity_findings_cid",
    "held_out_evaluation_cid",
    "held_out_result",
    "authorization_cid",
    "expected_old_revision",
    "seal_scope",
    "seal_status",
    "signature",
    "receipt_cid"
  ],
  "properties": {
    "schema": {
      "const": "ipfs-datasets.software-contracts.adversarial-assurance-campaign-receipt@1"
    },
    "interface_id": {
      "const": "AssuranceCampaignReceipt@1"
    },
    "header": {
      "$ref": "#/$defs/assuranceArtifactHeader"
    },
    "receipt_id": {
      "$ref": "#/$defs/token"
    },
    "campaign_plan_cid": {
      "$ref": "#/$defs/cid"
    },
    "campaign_policy_cid": {
      "$ref": "#/$defs/cid"
    },
    "campaign_policy_version": {
      "$ref": "#/$defs/versionToken"
    },
    "admitted_set_cid": {
      "$ref": "#/$defs/cid"
    },
    "expected_detection_sets_cid": {
      "$ref": "#/$defs/cid"
    },
    "outcomes_cid": {
      "$ref": "#/$defs/cid"
    },
    "survivor_reports_cid": {
      "$ref": "#/$defs/cid"
    },
    "vacuity_findings_cid": {
      "$ref": "#/$defs/cid"
    },
    "held_out_evaluation_cid": {
      "$ref": "#/$defs/cid"
    },
    "held_out_result": {
      "$ref": "#/$defs/heldOutResult"
    },
    "authorization_cid": {
      "$ref": "#/$defs/cid"
    },
    "expected_old_revision": {
      "$ref": "#/$defs/versionToken"
    },
    "seal_scope": {
      "$ref": "#/$defs/sealScope"
    },
    "seal_status": {
      "$ref": "#/$defs/sealAvailabilityStatus"
    },
    "seal_evidence_cid": {
      "$ref": "#/$defs/cidOrNull"
    },
    "gap_reports_cid": {
      "$ref": "#/$defs/cidOrNull"
    },
    "input_artifact_cids": {
      "$ref": "#/$defs/cidList"
    },
    "signature": {
      "$ref": "#/$defs/receiptSignatureBinding"
    },
    "notes": {
      "$ref": "#/$defs/nfcStringOrNull"
    },
    "metadata": {
      "$ref": "#/$defs/strictObject"
    },
    "receipt_cid": {
      "$ref": "#/$defs/cid"
    }
  },
  "$defs": {
    "cid": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^b[a-z2-7]+$"
    },
    "cidOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cid"
        }
      ]
    },
    "cidList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cid"
      },
      "uniqueItems": true,
      "maxItems": 4096
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$"
    },
    "versionToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+-]{0,255}$"
    },
    "nfcString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "nfcStringOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nfcString"
        }
      ]
    },
    "didKey": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]{10,200}$"
    },
    "keyIdentity": {
      "oneOf": [
        {
          "$ref": "#/$defs/didKey"
        },
        {
          "$ref": "#/$defs/cid"
        }
      ]
    },
    "audienceOrAction": {
      "oneOf": [
        {
          "$ref": "#/$defs/token"
        },
        {
          "$ref": "#/$defs/didKey"
        }
      ]
    },
    "signatureBytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43,512}$",
      "maxLength": 512
    },
    "strictObject": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "array"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "assuranceTerminalStatus": {
      "type": "string",
      "enum": [
        "complete",
        "rejected",
        "invalid",
        "stale",
        "inconclusive",
        "evaluation_failed",
        "human_review_required",
        "unavailable",
        "cancelled",
        "simulated"
      ]
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "live",
        "simulated",
        "replay"
      ]
    },
    "heldOutResult": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "not_applicable",
        "unavailable"
      ]
    },
    "sealAvailabilityStatus": {
      "type": "string",
      "enum": [
        "bound",
        "released",
        "unavailable",
        "not_requested",
        "rejected"
      ]
    },
    "signatureVerificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "invalid",
        "unavailable",
        "rejected"
      ]
    },
    "sealScopeItem": {
      "type": "string",
      "enum": [
        "operator_versions",
        "campaign_policy",
        "admitted_set",
        "expected_detection_sets",
        "outcomes",
        "survivor_reports",
        "vacuity_findings",
        "held_out_evaluations",
        "final_policy_revision",
        "campaign_artifacts",
        "declared_result_completeness",
        "evaluation_to_promotion_binding",
        "status_policy_satisfaction",
        "campaign_receipt",
        "promotion_receipt"
      ]
    },
    "sealScope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sealScopeItem"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "assuranceArtifactHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "interface_id",
        "artifact_kind",
        "repository_id",
        "repository_state_cid",
        "terminal_status",
        "execution_mode",
        "header_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.adversarial-assurance-artifact-header@1"
        },
        "interface_id": {
          "const": "AssuranceArtifactHeader@1"
        },
        "artifact_kind": {
          "const": "assurance_campaign_receipt"
        },
        "repository_id": {
          "$ref": "#/$defs/repositoryId"
        },
        "repository_state_cid": {
          "$ref": "#/$defs/cid"
        },
        "terminal_status": {
          "$ref": "#/$defs/assuranceTerminalStatus"
        },
        "execution_mode": {
          "$ref": "#/$defs/executionMode"
        },
        "header_cid": {
          "$ref": "#/$defs/cid"
        }
      }
    },
    "receiptSignatureBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "signer_identity",
        "key_identity",
        "audience",
        "action",
        "signature_algorithm",
        "signature_authority",
        "signature",
        "signature_verification_status",
        "binding_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.adversarial-assurance-receipt-signature-binding@1"
        },
        "signer_identity": {
          "$ref": "#/$defs/didKey"
        },
        "key_identity": {
          "$ref": "#/$defs/keyIdentity"
        },
        "audience": {
          "$ref": "#/$defs/audienceOrAction"
        },
        "action": {
          "$ref": "#/$defs/audienceOrAction"
        },
        "signature_algorithm": {
          "const": "EdDSA"
        },
        "signature_authority": {
          "const": "ipfs-datasets.profile-g.ed25519-did-key@1"
        },
        "signature": {
          "$ref": "#/$defs/signatureBytes"
        },
        "signature_verification_status": {
          "$ref": "#/$defs/signatureVerificationStatus"
        },
        "binding_cid": {
          "$ref": "#/$defs/cid"
        }
      }
    }
  }
}
