  "environment_discharge_rules": [
    {
      "id": "env-discharge:explicit-unresolved-allowed",
      "description": "An environmental assumption may remain composition-safe only when marked explicit_unresolved with a non-empty unresolved_reason.",
      "requires_fields": [
        "explicit_unresolved",
        "unresolved_reason"
      ],
      "rejection_code": "ENV_UNDISCLOSED_PREMISE"
    },
    {
      "id": "env-discharge:provider-before-composition",
      "description": "A non-environment assumption must be discharged by a qualified provider guarantee before composition admits the consumer.",
      "rejection_code": "ENV_PROVIDER_DISCHARGE_REQUIRED"
    },
    {
      "id": "env-discharge:no-assume-away-defect",
      "description": "Counterexamples may refine assumptions but must not erase a component defect by silently dropping a required guarantee.",
      "rejection_code": "ENV_ASSUME_AWAY_COMPONENT_DEFECT"
    }
  ],
  "terminal_workflow": [
    "swissknife_request",
    "host_authentication_and_admission",
    "datasets_semantic_compilation_translation_receipt",
    "accelerate_scheduling_and_observed_execution",
    "kit_immutable_persistence_current_pointer",
    "swissknife_evidence_presentation"
  ],
  "seeded_integration_failures": [
    {
      "id": "seed:browser-allow-as-admission",
      "description": "Browser constructs an allow-like decision and attempts to unlock a handler.",
      "violated_boundary_id": "boundary:accelerate->swissknife.nonauthority",
      "broken_guarantee_id": "guarantee:swissknife.nonauthority",
      "broken_assumption_id": "assumption:accelerate.host_authenticated_policy",
      "fault": {
        "actor": "browser",
        "action": "construct_allow_decision",
        "claimed_effect": "admission_unlock"
      },
      "expected_violation_code": "BOUNDARY_VIOLATED:boundary:accelerate->swissknife.nonauthority"
    },
    {
      "id": "seed:candidate-to-current",
      "description": "Kit promotes a candidate proof seal directly to current.",
      "violated_boundary_id": "boundary:swissknife->kit.proof_roles",
      "broken_guarantee_id": "guarantee:kit.proof_role_separation",
      "broken_assumption_id": "assumption:swissknife.kit_receipt_integrity",
      "fault": {
        "actor": "ipfs_kit_py",
        "action": "promote_candidate_to_current",
        "claimed_effect": "current_pointer_update"
      },
      "expected_violation_code": "BOUNDARY_VIOLATED:boundary:swissknife->kit.proof_roles"
    },
    {
      "id": "seed:success-without-observation",
      "description": "Accelerate reports execution success without independent observation.",
      "violated_boundary_id": "boundary:kit->accelerate.observation",
      "broken_guarantee_id": "guarantee:accelerate.observed_execution",
      "broken_assumption_id": "assumption:kit.admission_before_current_update",
      "fault": {
        "actor": "ipfs_accelerate_py",
        "action": "report_success_boolean",
        "claimed_effect": "execution_complete"
      },
      "expected_violation_code": "BOUNDARY_VIOLATED:boundary:kit->accelerate.observation"
    },
    {
      "id": "seed:datasets-external-effect-success",
      "description": "Datasets emits a success-shaped external-effect claim, breaking pure-semantics qualification.",
      "violated_boundary_id": "boundary:accelerate->datasets.semantics",
