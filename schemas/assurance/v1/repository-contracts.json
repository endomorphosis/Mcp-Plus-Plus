      "guarantee_id": "guarantee:kit.proof_role_separation",
      "workflow_step": "kit_immutable_persistence_current_pointer",
      "violation_code": "BOUNDARY_VIOLATED:boundary:swissknife->kit.proof_roles"
    },
    {
