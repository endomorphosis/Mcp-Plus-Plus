      "consumer_repository": "swissknife",
      "provider_repository": "ipfs_datasets_py",
      "assumption_id": "assumption:swissknife.datasets_translation",
      "guarantee_id": "guarantee:datasets.translation_receipt_names_loss",
      "workflow_step": "datasets_semantic_compilation_translation_receipt",
      "violation_code": "BOUNDARY_VIOLATED:boundary:swissknife->datasets.translation"
    },
    {
      "id": "boundary:accelerate->datasets.semantics",
      "consumer_repository": "ipfs_accelerate_py",
      "provider_repository": "ipfs_datasets_py",
      "assumption_id": "assumption:accelerate.datasets_semantics",
      "guarantee_id": "guarantee:datasets.pure_ir_semantics",
      "workflow_step": "datasets_semantic_compilation_translation_receipt",
      "violation_code": "BOUNDARY_VIOLATED:boundary:accelerate->datasets.semantics"
    },
    {
      "id": "boundary:accelerate->kit.persistence",
      "consumer_repository": "ipfs_accelerate_py",
      "provider_repository": "ipfs_kit_py",
      "assumption_id": "assumption:accelerate.kit_persistence",
      "guarantee_id": "guarantee:kit.cas_integrity",
